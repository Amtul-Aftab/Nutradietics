# Nutradietics — environment variable template
# Copy this file to .env and fill in real values. Do NOT put real secrets here.

# --- Database (PostgreSQL, used by Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Runtime queries (Supabase: transaction pooler, port 6543).
DATABASE_URL=
# Migrations (Supabase: session pooler, port 5432). Used as Prisma directUrl.
DIRECT_URL=

# --- Auth.js (NextAuth) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Base URL of the app (e.g. http://localhost:3000 in dev)
NEXTAUTH_URL=

# --- AI provider (server-side only; never exposed to the client) ---
# Up to three keys enable round-robin failover: each AI call starts with a
# different key to spread daily quota evenly across them, and a rate-limit
# (429) on the first-tried key falls through the remaining keys before giving
# up. Set only AI_API_KEY for single-key behavior; add _2 / _3 to expand.
AI_API_KEY=
AI_API_KEY_2=
AI_API_KEY_3=
# Request timeout for AI calls, in milliseconds (45s covers the longer summary call)
AI_TIMEOUT_MS=45000
# --- Supabase Storage (profile pictures; server-side only) ---
# Project URL: Supabase dashboard -> Settings -> API -> Project URL
SUPABASE_URL=
# service_role secret key: Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Email verification (Resend; server-side only) ---
# API key from https://resend.com (Dashboard -> API Keys). Email verification
# is optional and non-blocking: without a working key + sender the send is
# skipped, but signup and sign-in still work regardless of verification status.
RESEND_API_KEY=
# From-address for verification emails. Defaults to Resend's sandbox sender
# (noreply@resend.dev) which needs no domain setup; use a verified domain in prod.
EMAIL_FROM=noreply@resend.dev
# Absolute base URL used to build verification links. Falls back to NEXTAUTH_URL,
# then http://localhost:3000. Set explicitly in production (e.g. https://yourdomain).
APP_BASE_URL=
